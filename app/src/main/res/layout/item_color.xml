<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_color"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="32dp"
    app:cardBackgroundColor="@color/card_blue"
    app:cardElevation="4dp">

        <!-- Vista interna para añadir bordes sin alterar el CardView -->
        <View
            android:id="@+id/border_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/border_transparent" />

        <ImageView
            android:id="@+id/ColorHex"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_palette"
            app:tint="@color/white"
            android:contentDescription="@string/category_colores" />


</androidx.cardview.widget.CardView>