<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- Top Bar -->
            <RelativeLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/bg_settings_icon"
                    android:src="@drawable/ic_back"
                    android:padding="12dp"
                    android:tint="@color/settings_icon"
                    android:contentDescription="@string/back_desc" />

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/bg_settings_icon">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_paw"
                        app:tint="@color/settings_icon" />
                </FrameLayout>

                <!--<androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_settings_icon"
                    android:src="@drawable/ic_settings"
                    android:padding="12dp"
                    android:tint="@color/settings_icon"
                    android:contentDescription="@string/settings_desc" />-->

            </RelativeLayout>

            <!-- Title and Subtitle -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/topBar"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_animales"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/title_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/choose_animal"
                    android:textSize="16sp"
                    android:textColor="@color/subtitle_color"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Animals Grid -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/headerLayout"
                android:layout_above="@id/bottomNav"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:padding="8dp">

                    <!-- Perro -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="#FFF5F7"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/bg_settings_icon"
                                android:backgroundTint="#FCE4EC">
                                <!-- Espacio para perro.png -->
                                <ImageView
                                    android:id="@+id/imgPerro"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/perro" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/animal_perro"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/title_color" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Gato -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="#FFF5F7"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/bg_settings_icon"
                                android:backgroundTint="#FCE4EC">
                                <!-- Espacio para gato.png -->
                                <ImageView
                                    android:id="@+id/imgGato"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/gato" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/animal_gato"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/title_color" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Conejo -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="#FFF5F7"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/bg_settings_icon"
                                android:backgroundTint="#FCE4EC">
                                <!-- Espacio para conejo.png -->
                                <ImageView
                                    android:id="@+id/imgConejo"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/conejo" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/animal_conejo"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/title_color" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Elefante -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="#FFF5F7"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/bg_settings_icon"
                                android:backgroundTint="#FCE4EC">
                                <!-- Espacio para elefante.png -->
                                <ImageView
                                    android:id="@+id/imgElefante"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/elefante" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/animal_elefante"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/title_color" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- León -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="#FFF5F7"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/bg_settings_icon"
                                android:backgroundTint="#FCE4EC">
                                <!-- Espacio para leon.png -->
                                <ImageView
                                    android:id="@+id/imgLeon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/leon" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/animal_leon"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/title_color" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Jirafa -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardBackgroundColor="#FFF5F7"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <FrameLayout
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/bg_settings_icon"
                                android:backgroundTint="#FCE4EC">
                                <!-- Espacio para jirafa.png -->
                                <ImageView
                                    android:id="@+id/imgJirafa"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/jirafa" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/animal_jirafa"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/title_color" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </GridLayout>
            </ScrollView>

            <!-- Bottom Navigation -->
            <LinearLayout
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_bottom_nav"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_shapes"
                        app:tint="#B39DDB" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_objetos"
                        android:textColor="#B39DDB"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnColores"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_palette"
                        app:tint="#4DB6AC" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_colores"
                        android:textColor="#4DB6AC"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>